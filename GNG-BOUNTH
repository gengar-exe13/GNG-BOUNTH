function UI:_layoutTabs()
	local n = #self._tabs
	if n <= 5 then
		self._tabbar.CanvasSize = UDim2.new()
		for i, t in ipairs(self._tabs) do
			t._btn.Size = UDim2.new(1 / n, i == n and 0 or -1, 1, 0)
			t._btn.Position = UDim2.new((i - 1) / n, 0, 0, 0)
		end
		return
	end
	local x = 0
	for _, t in ipairs(self._tabs) do
		local w = math.clamp(#t._lbl.Text * 7 + 24 + (t._icon and 18 or 0), 60, 190)
		t._btn.Size = UDim2.fromOffset(w, 20)
		t._btn.Position = UDim2.fromOffset(x, 0)
		x = x + w + 2
	end
