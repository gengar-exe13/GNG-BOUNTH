function UI:CreateKeybind(config)
	config = config or {}
	local callback = resolveCallback(config)
	local currentKey = config.Default or config.CurrentKeybind or Enum.KeyCode.RightShift
	if typeof(currentKey) == "string" then
		local ok, parsed = pcall(function() return Enum.KeyCode[currentKey] end)
		currentKey = (ok and parsed) or Enum.KeyCode.RightShift
	end
	local listening = false
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local body = tabBody(owner, 20)
	local row = rowFrame(body, 20, nextOrder(owner))
	indexWidget(owner, config.Text or config.Name or "Tecla", row)
	label({ Text = tostring(config.Text or config.Name or "Tecla"), Size = UDim2.new(1, -70, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	local KeyButton = new("TextButton", {
		Text = currentKey.Name, Font = Theme.FontMono, TextSize = 11, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 64, 0, 18), Parent = row,
	}, { stroke(Theme.Border, 1), gloss() })
	local Keybind = setmetatable({ Instance = KeyButton, Value = currentKey, Callback = callback, _threads = {} }, UI)
	function Keybind:Set(keyCode)
		if typeof(keyCode) == "string" then
			local ok, parsed = pcall(function() return Enum.KeyCode[keyCode] end)
			keyCode = (ok and parsed) or self.Value
		end
		self.Value = keyCode
		KeyButton.Text = keyCode.Name
		setFlagValue(config.Flag, keyCode)
	end
	function Keybind:Get() return self.Value end
	function Keybind:Stop() stopAllThreads(self) end
	table.insert(window._connections, KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
		KeyButton.TextColor3 = Theme.Active
	end))
	table.insert(window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			KeyButton.TextColor3 = Theme.Text
			Keybind:Set(input.KeyCode)
			return
		end
		if not listening and not gameProcessed and input.KeyCode == Keybind.Value then
			safeCall(Keybind, Keybind.Callback, Keybind.Value)
		end
	end))
	registerFlag(config.Flag, Keybind, currentKey)
	return Keybind
end
function UI:CreateTab(config, icon)
	if typeof(config) == "string" then config = { Name = config } end
	config = config or {}
	if icon ~= nil then config.Icon = icon end
	if config.Icon == nil then config.Icon = config.IconName or config.Image end
	local window = self
	local name = tostring(config.Text or config.Name or config.Title or ("Tab " .. (#window._tabs + 1)))
	local page = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, Size = UDim2.new(1, 0, 1, 0), Parent = window._content,
	})
	local function column(x)
		return new("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(x, x == 0 and 0 or 3, 0, 0),
			Size = UDim2.new(0.5, -3, 1, 0), ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page,
		}, { new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }), pad(0, 8, 2, 4) })
	end
	local btn = new("TextButton", {
		Text = "", BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AutoButtonColor = false, Parent = window._tabbar,
	}, { stroke(Theme.Border, 1), gloss() })
	local lbl = label({
		Text = string.lower(name), TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 1, 0), Parent = btn,
	})
	local tab = setmetatable({
		Window = window, Name = name, List = page, Root = page, _page = page, _btn = btn, _lbl = lbl,
		_cols = { column(0), column(0.5) }, _heights = { 0, 0 }, _opts = {}, _rowCount = 0, _threads = {},
	}, UI)
	function tab:SetIcon(spec)
		if self._icon then self._icon.box:Destroy() self._icon = nil end
