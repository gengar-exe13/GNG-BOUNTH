do
	local Lighting = game:GetService("Lighting")
	local active = false
	local conns = {}
	local touched = setmetatable({}, { __mode = "k" })
	local original
	local function soften(inst)
		if not active or touched[inst] then
			return
		end
		local mine = game:GetService("Players").LocalPlayer.Character
		if mine and inst:IsDescendantOf(mine) then
			return
		end
		pcall(function()
			if inst:IsA("ParticleEmitter") then
				touched[inst] = { inst.Enabled, inst.Rate, inst.Lifetime }
				inst.Enabled = false
				inst.Rate = 0
				inst.Lifetime = NumberRange.new(0)
			elseif inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") or inst:IsA("Trail") then
				touched[inst] = { inst.Enabled }
				inst.Enabled = false
			elseif inst:IsA("Explosion") then
				touched[inst] = { inst.Visible }
				inst.Visible = false
				inst.BlastPressure = 0
			elseif
				inst:IsA("BloomEffect")
				or inst:IsA("BlurEffect")
				or inst:IsA("SunRaysEffect")
				or inst:IsA("DepthOfFieldEffect")
			then
				touched[inst] = { inst.Enabled }
				inst.Enabled = false
			end
		end)
	end
	local function restore()
		for inst, v in pairs(touched) do
			pcall(function()
				if inst:IsA("ParticleEmitter") then
					inst.Enabled, inst.Rate, inst.Lifetime = v[1], v[2], v[3]
				elseif inst:IsA("Explosion") then
					inst.Visible = v[1]
				else
					inst.Enabled = v[1]
				end
			end)
		end
		table.clear(touched)
	end
	function AntiLagSet(on)
		if on == active then
			return
		end
		active = on and true or false
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		table.clear(conns)
		if active then
			original = {
				shadows = Lighting.GlobalShadows,
				quality = settings().Rendering.QualityLevel,
				waveSize = workspace.Terrain.WaterWaveSize,
				waveSpeed = workspace.Terrain.WaterWaveSpeed,
				reflect = workspace.Terrain.WaterReflectance,
			}
			pcall(function()
				Lighting.GlobalShadows = false
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level04
				workspace.Terrain.WaterWaveSize = 0
				workspace.Terrain.WaterWaveSpeed = 0
				workspace.Terrain.WaterReflectance = 0
			end)
			conns[#conns + 1] = workspace.DescendantAdded:Connect(soften)
			conns[#conns + 1] = Lighting.DescendantAdded:Connect(soften)
			task.spawn(function()
				local n = 0
				for _, d in ipairs(workspace:GetDescendants()) do
					if not active then
						return
					end
					soften(d)
					n = n + 1
					if n % 400 == 0 then
						task.wait()
					end
				end
				for _, d in ipairs(Lighting:GetDescendants()) do
					soften(d)
				end
			end)
		else
			restore()
			if original then
				pcall(function()
					Lighting.GlobalShadows = original.shadows
					settings().Rendering.QualityLevel = original.quality
					workspace.Terrain.WaterWaveSize = original.waveSize
					workspace.Terrain.WaterWaveSpeed = original.waveSpeed
					workspace.Terrain.WaterReflectance = original.reflect
				end)
			end
		end
	end
end
