local function drawGengarFace(parent, w, _h, anchor, pos, style)
	local cols, nrows = #GENGAR_ROWS[1], #GENGAR_ROWS
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = pos
	f.Size = UDim2.fromOffset(w, math.floor(w * nrows / cols + 0.5))
	f.Parent = parent
	local colors = {
		["#"] = Color3.fromRGB(8, 4, 14),
		["e"] = Color3.fromRGB(120, 72, 185),
		["o"] = Color3.fromRGB(250, 250, 250),
	}
	local trans = { ["#"] = 0, ["e"] = 0, ["o"] = 0 }
	local zBase = 2
	if style then
		colors = { ["#"] = style.fill, ["e"] = style.edge, ["o"] = style.white }
		trans = { ["#"] = style.tf or 0, ["e"] = style.te or 0, ["o"] = style.tw or 0 }
		zBase = style.z or 1
	end
	for y, row in ipairs(GENGAR_ROWS) do
		local x = 1
		while x <= cols do
			local c = row:sub(x, x)
			if c ~= "." then
				local x2 = x
				while x2 < cols and row:sub(x2 + 1, x2 + 1) == c do x2 = x2 + 1 end
				local b = Instance.new("Frame")
				b.BorderSizePixel = 0
				b.BackgroundColor3 = colors[c]
				b.BackgroundTransparency = trans[c]
				b.Position = UDim2.new((x - 1) / cols, 0, (y - 1) / nrows, 0)
				b.Size = UDim2.new((x2 - x + 1) / cols, 0, 1 / nrows, 1)
				b.ZIndex = c == "o" and zBase + 1 or zBase
				b.Parent = f
				x = x2 + 1
			else
				x = x + 1
			end
		end
	end
	return f
end
