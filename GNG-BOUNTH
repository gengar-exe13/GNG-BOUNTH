	indexWidget(owner, text, row)
	local Btn = new("TextButton", {
		Text = tostring(text), Font = Theme.Font, TextSize = Theme.TextSize, TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AutoButtonColor = false, Size = UDim2.new(1, 0, 1, 0), Parent = row,
	}, { stroke(Theme.Border, 1), gloss() })
	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, UI)
	function Button:Set(...)
		Btn.BackgroundColor3 = Theme.Active
		Btn.TextColor3 = Theme.OnAccent
		task.delay(0.15, function()
			if Btn.Parent then Btn.BackgroundColor3 = Theme.Field Btn.TextColor3 = Theme.Text end
		end)
		return safeCall(self, self.Callback, ...)
	end
	Button.Fire = Button.Set
	function Button:Stop() stopAllThreads(self) end
	table.insert(window._connections, Btn.MouseEnter:Connect(function() if Btn.BackgroundColor3 == Theme.Field then Btn.BackgroundColor3 = Theme.Line end end))
	table.insert(window._connections, Btn.MouseLeave:Connect(function() if Btn.BackgroundColor3 == Theme.Line then Btn.BackgroundColor3 = Theme.Field end end))
	table.insert(window._connections, Btn.MouseButton1Click:Connect(function() Button:Set() end))
	registerFlag(config.Flag, Button, nil)
	return Button
end
