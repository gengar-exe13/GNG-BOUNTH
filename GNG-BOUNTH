function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)
	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then rangeMin = rangeMin or config.Range[1] rangeMax = rangeMax or config.Range[2] end
	local min, max = rangeMin or 0, rangeMax or 100
	if max <= min then max = min + 1 end
	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end
	local decimals = 0
	if step < 1 then decimals = math.min(#tostring(step):gsub("^%d*%.?", ""), 3) end
	local function snap(v) v = math.clamp(v, min, max) return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max) end
	local function show(v) if decimals > 0 then return string.format("%." .. decimals .. "f", v) end return tostring(math.floor(v + 0.5)) end
	local value = snap(config.Default or config.CurrentValue or min)
	local initial = value
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local body = tabBody(owner, 34)
	local row = rowFrame(body, 34, nextOrder(owner))
	indexWidget(owner, config.Text or config.Name or "Valor", row)
	local opt = makeOption(owner)
	label({ Text = tostring(config.Text or config.Name or "Valor"), Size = UDim2.new(1, 0, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	local bar = new("Frame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 17), Size = UDim2.new(1, 0, 0, 15),
		ClipsDescendants = true, Parent = row,
	}, { stroke(Theme.Border, 1), gloss() })
	local fill = new("Frame", { BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = bar }, { gloss() })
	local marker = new("Frame", { BackgroundColor3 = Theme.Text, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.new(0, 1, 1, 0), ZIndex = 2, Parent = bar })
	local txt = label({
		Text = "", TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 1, 0), ZIndex = 3,
		TextStrokeColor3 = Color3.new(0, 0, 0), TextStrokeTransparency = 0.3, Parent = bar,
	})
	local Slider = setmetatable({ Instance = bar, Value = value, Min = min, Max = max, Callback = callback, _threads = {} }, UI)
	local function repaint(v)
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		marker.Position = UDim2.new((v - min) / (max - min), 0, 0, 0)
		txt.Text = show(v) .. "/" .. show(max)
	end
	function Slider:Set(newValue, whileDragging)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		opt.SetActive(newValue ~= initial)
		setFlagValue(config.Flag, newValue, whileDragging)
		return safeCall(self, self.Callback, newValue)
	end
	function Slider:Get() return self.Value end
	function Slider:Stop() stopAllThreads(self) end
	repaint(value)
	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + rel * (max - min), dragging)
	end
	table.insert(window._connections, bar.InputBegan:Connect(function(i) if isClick(i) then dragging = true setFromX(i.Position.X) end end))
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(i) if dragging and isMove(i) then setFromX(i.Position.X) end end))
	table.insert(window._connections, UserInputService.InputEnded:Connect(function(i)
		if isClick(i) and dragging then
			dragging = false
			setFlagValue(config.Flag, Slider.Value)
		end
	end))
	opt.SetActive(false)
	registerFlag(config.Flag, Slider, value)
	return Slider
end
function UI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or config.Values or {}
	local multi = config.Multi == true
	local function display(v) if typeof(v) == "Instance" then return v.Name end if typeof(v) == "table" and v.Name then return tostring(v.Name) end return tostring(v) end
	local function isValid(v) for _, o in ipairs(options) do if o == v then return true end end return false end
	local selected = options[1]
	local wanted = config.Default
	if wanted == nil then wanted = config.CurrentOption end
	if config.AllowEmpty and wanted == nil then selected = nil end
	if wanted ~= nil and isValid(wanted) then selected = wanted end
	local selSet = {}
	if multi then
		selected = nil
		local d = config.DefaultSet or config.Default
		if typeof(d) == "table" then
			for k, v in pairs(d) do
				if typeof(k) == "number" then selSet[v] = true elseif v then selSet[k] = true end
			end
		end
	end
	local initial = selected
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local body = tabBody(owner, 41)
	local opt = makeOption(owner)
	local ROW_H, MAX_ROWS = 18, 6
	local holder = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = nextOrder(owner), Parent = body,
	}, { new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }) })
	indexWidget(owner, config.Text or config.Name or "Opciones", holder)
	label({ Text = tostring(config.Text or config.Name or "Opciones"), Size = UDim2.new(1, 0, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, Parent = holder })
	local head = new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 19), LayoutOrder = 2, Parent = holder,
	}, { stroke(Theme.Border, 1), gloss() })
	local cur = label({ Text = "", Position = UDim2.new(0, 5, 0, 0), Size = UDim2.new(1, -22, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
	local arrowBox = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.new(0, 9, 0, 5), Parent = head })
	local arrowDown = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = arrowBox })
	local arrowUp = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Visible = false, Parent = arrowBox })
	drawPixels(arrowDown, { "#########", ".#######.", "..#####..", "...###...", "....#...." }, Theme.Text)
	drawPixels(arrowUp, { "....#....", "...###...", "..#####..", ".#######.", "#########" }, Theme.Active)
	local listFrame = new("ScrollingFrame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Visible = false, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0),
		ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = holder,
	}, { stroke(Theme.Line, 1), new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })
	local Dropdown = setmetatable({ Instance = head, Value = multi and selSet or selected, Options = options, Callback = callback, _threads = {} }, UI)
	local buttons = {}
	local function headText()
		if multi then
			local names = {}
			for _, o in ipairs(options) do if selSet[o] then names[#names + 1] = display(o) end end
			if #names == 0 then return "-" end
			if #names <= 2 then return table.concat(names, ", ") end
			return #names .. " seleccionados"
		end
		return Dropdown.Value ~= nil and display(Dropdown.Value) or "-"
	end
	local function paint()
		for _, b in ipairs(buttons) do
			if multi then
				local on = selSet[b.opt] == true
				b.btn.Text = (on and " [x] " or " [ ] ") .. display(b.opt)
				b.btn.TextColor3 = on and Theme.Active or Theme.TextDim
			else
				b.btn.TextColor3 = (b.opt == Dropdown.Value) and Theme.Active or Theme.TextDim
			end
		end
		cur.Text = headText()
	end
	local function anySelected() for _, o in ipairs(options) do if selSet[o] then return true end end return false end
	local function close() listFrame.Visible = false arrowDown.Visible = true arrowUp.Visible = false end
	local function rebuild()
		for _, b in ipairs(buttons) do b.btn:Destroy() end
		table.clear(buttons)
		for i, o in ipairs(options) do
			local b = new("TextButton", {
				Text = " " .. display(o), Font = Theme.Font, TextSize = Theme.TextSize, TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, BorderSizePixel = 0,
				AutoButtonColor = false, Size = UDim2.new(1, 0, 0, ROW_H), LayoutOrder = i, Parent = listFrame,
			})
			b.MouseButton1Click:Connect(function()
				if multi then
					selSet[o] = not selSet[o]
					paint()
					opt.SetActive(anySelected())
					setFlagValue(config.Flag, selSet)
					safeCall(Dropdown, Dropdown.Callback, o, selSet[o] == true)
				else
					Dropdown:Set(o) close()
				end
			end)
			table.insert(buttons, { btn = b, opt = o })
		end
		listFrame.Size = UDim2.new(1, 0, 0, math.min(#options, MAX_ROWS) * ROW_H + 2)
		paint()
	end
	function Dropdown:Set(option)
		if multi then
			local new = {}
			if typeof(option) == "table" then
				for k, v in pairs(option) do
					if typeof(k) == "number" then new[v] = true elseif v then new[k] = true end
				end
			end
			for _, o in ipairs(options) do
				local was, now = selSet[o] == true, new[o] == true
				selSet[o] = now or nil
				if was ~= now then safeCall(self, self.Callback, o, now) end
			end
			paint()
			opt.SetActive(anySelected())
			setFlagValue(config.Flag, selSet)
			return
		end
		self.Value = option
		cur.Text = option ~= nil and display(option) or "-"
		paint()
		opt.SetActive(option ~= initial)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end
	function Dropdown:Get() return self.Value end
	function Dropdown:Stop() stopAllThreads(self) end
	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		options = self.Options
		if multi then
			for k in pairs(selSet) do if not isValid(k) then selSet[k] = nil end end
		elseif not keepSelection then
			self.Value = options[1]
		end
		rebuild()
	end
	Dropdown.SetOptions = Dropdown.Refresh
	table.insert(window._connections, head.MouseButton1Click:Connect(function()
		listFrame.Visible = not listFrame.Visible
		arrowDown.Visible = not listFrame.Visible
		arrowUp.Visible = listFrame.Visible
	end))
	rebuild()
	opt.SetActive(multi and anySelected() or false)
	registerFlag(config.Flag, Dropdown, multi and selSet or selected)
	return Dropdown
end
