function UI:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local on = (t == tab)
		t._on = on
		t._page.Visible = on
		t._btn.BackgroundColor3 = on and Theme.Active or Theme.Field
		t._lbl.TextColor3 = on and Theme.OnAccent or Theme.Text
		if t._icon then t._icon.paint(on and Theme.OnAccent or Theme.Text) end
	end
	self._current = tab
	pcall(function()
		local bar = self._tabbar
		if tab and tab._btn and bar.CanvasSize.X.Offset > bar.AbsoluteSize.X then
			local left, right = tab._btn.Position.X.Offset, tab._btn.Position.X.Offset + tab._btn.Size.X.Offset
			local pos = bar.CanvasPosition.X
			if left < pos then pos = left - 4 elseif right > pos + bar.AbsoluteSize.X then pos = right - bar.AbsoluteSize.X + 4 end
			bar.CanvasPosition = Vector2.new(math.max(0, pos), 0)
		end
	end)
	self:_activeRefresh()
end
